<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Browser build of the practice authority for static hosting (GitHub Pages). Same PracticeMatch as the
       ASP.NET app; only the transport changes. The client files come from src/Domino.Desktop/wwwroot. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Snapshots are anonymous objects serialized by reflection, so keep reflection JSON and the game assemblies. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <CompressionEnabled>false</CompressionEnabled>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IL2026: the JSON types are kept by the TrimmerRootAssembly entries below. -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Domino.Infrastructure/Domino.Infrastructure.csproj" />
    <TrimmerRootAssembly Include="Domino.Application" />
    <TrimmerRootAssembly Include="Domino.Domain" />
    <TrimmerRootAssembly Include="Domino.Web" />
  </ItemGroup>
</Project>
